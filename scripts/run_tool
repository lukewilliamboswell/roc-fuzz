#!/usr/bin/env bash
# Separate compiler warning status from the Roc program's actual exit status.
set -euo pipefail
source_file=${1:?Usage: scripts/run_tool scripts/tool.roc [--] [arguments...]}
shift
if [[ ${1:-} == -- ]]; then shift; fi
roc_tooling=${ROC_STABLE:-roc-stable}
tool_dir=$(mktemp -d "${TMPDIR:-/tmp}/roc-fuzz-tool.XXXXXXXX")
trap 'rm -rf "$tool_dir"' EXIT
compile_status=0
"$roc_tooling" build --opt=dev "$source_file" --output="$tool_dir/tool" || compile_status=$?
if [[ $compile_status != 0 && $compile_status != 2 ]]; then exit "$compile_status"; fi
if [[ ! -x "$tool_dir/tool" ]]; then
  echo "Roc did not produce the tooling executable: $source_file" >&2
  exit 1
fi
"$tool_dir/tool" "$@"
